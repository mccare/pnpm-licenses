{
  "name": "@quantco/pnpm-licenses",
  "version": "2.2.1",
  "description": "Generate third party license disclaimers in pnpm-based projects",
  "homepage": "https://github.com/Quantco/pnpm-licenses",
  "repository": {
    "type": "git",
    "url": "https://github.com/Quantco/pnpm-licenses"
  },
  "bugs": {
    "url": "https://github.com/Quantco/pnpm-licenses/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "readme.md"
  ],
  "bin": {
    "pnpm-licenses": "dist/index.mjs"
  },
  "keywords": [
    "spdx",
    "license",
    "pnpm",
    "cli"
  ],
  "author": "Janina Wibker",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint ./src --ext ts",
    "cli": "node ./dist/index.mjs",
    "prettier:check": "prettier --check .",
    "prettify": "prettier --write ."
  },
  "dependencies": {
    "ansi-colors": "4.1.3",
    "color-support": "1.1.3",
    "minimist": "1.2.8",
    "multimatch": "7.0.0",
    "remove-markdown": "0.6.2",
    "spdx-license-list": "6.10.0",
    "strip-indent": "4.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/minimist": "1.2.5",
    "@types/node": "24.10.0",
    "@types/spdx-expression-parse": "3.0.5",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "9.39.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.23.1",
    "eslint-plugin-promise": "7.2.1",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "typescript": "5.9.3"
  }
}
